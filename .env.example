# Environment Configuration Template
# Database URL for MySQL 8.0+ (InnoDB utf8mb4)
DATABASE_URL=mysql+pymysql://recruit_user:recruit_password@localhost:3306/recruitment_db?charset=utf8mb4

# SQLite fallback for lightweight local dev/testing without local MySQL:
# DATABASE_URL=sqlite:///./recruitment.db

# Application Configuration
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Synthetic Data Generation Seed
RANDOM_SEED=20261022
OUTPUT_DIR=data/generated
